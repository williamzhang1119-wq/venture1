# Stripe — use restricted keys (rk_*) when possible. Never commit real keys.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs created by: npm run stripe:setup
STRIPE_PRICE_FAMILY_MONTHLY=price_...
STRIPE_PRICE_FAMILY_YEARLY=price_...

# Set to true only after Tax Settings are active + registrations exist.
# Leave unset to auto-detect. Set false on claimable sandboxes without Tax access.
# STRIPE_AUTOMATIC_TAX=true

# Public site URL used for Checkout success/cancel + Customer Portal return
APP_BASE_URL=http://localhost:3000

# Existing chat proxy
ANTHROPIC_API_KEY=

PORT=3000
